# Copy to .env (gitignored). Used by docker-compose.yml. All four required
# together for login to work - the dedicated server disables /auth/* (501)
# if any is missing.

# anfall-auth issuer URL
OIDC_ISSUER=https://auth.anfall.net
# Client registered at anfall-auth for this server:
#   curl -X POST https://auth.anfall.net/api/clients/admin/register \
#     -H "Content-Type: application/json" -b cookies.txt \
#     -d '{"name":"flatcraft","redirectUris":["https://flatcraft.anfall.net/auth/callback"]}'
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# This server's own public origin (must match the OIDC_CLIENT_ID's registered
# redirectUri minus the /auth/callback suffix).
PUBLIC_URL=https://flatcraft.anfall.net
